# ============================================================
# Project application DB
# Used by FastAPI, Streamlit Dashboard, pipeline scripts
# ============================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=


# ============================================================
# Airflow metadata DB
# Used only by Airflow apiserver/scheduler/dag-processor/triggerer
# ============================================================
AIRFLOW_DB_HOST=postgres
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=

AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=


# ============================================================
# MLflow backend / artifact store
# ============================================================
MLFLOW_DB_NAME=mlflow
MLFLOW_TRACKING_URI=
MLFLOW_ARTIFACT_ROOT=/opt/airflow/project/mlartifacts
MLFLOW_EXPERIMENT_NAME=jobskill-classifier


# ============================================================
# Model performance gate
# ============================================================
MIN_MODEL_ACCURACY=0.7
MIN_MODEL_F1_WEIGHTED=0.7

# Class-level model performance gate
MIN_CLASS_F1=0.70
MIN_CLASS_RECALL=0.60
MIN_CLASS_SUPPORT=1


# ============================================================
# Model paths
# ============================================================
MODEL_NAME=job_classifier
MODEL_PATH=models/job_classifier.pkl
BEST_MODEL_PATH=models/best/job_classifier.pkl


# ============================================================
# Airflow secrets
# Do not commit real values.
# Keep your current local values here.
# ============================================================
AIRFLOW_JWT_SECRET=<KEEP_YOUR_CURRENT_AIRFLOW_JWT_SECRET>
AIRFLOW_API_SECRET_KEY=<KEEP_YOUR_CURRENT_AIRFLOW_API_SECRET_KEY>
AIRFLOW_FERNET_KEY=<KEEP_YOUR_CURRENT_AIRFLOW_FERNET_KEY>


# ============================================================
# Prediction settings
# ============================================================
LOW_CONFIDENCE_THRESHOLD=0.6
PREDICTION_TOP_K=3


# ============================================================
# Data source mode
# ============================================================
DATA_SOURCE_MODE=mixed


# ============================================================
# Remote OK crawler
# ============================================================
REMOTEOK_CRAWL_LIMIT=50
REMOTEOK_SCAN_LIMIT=1000
REMOTEOK_FILTER_ENABLED=true
REMOTEOK_MIN_RELEVANCE_SCORE=2

REMOTEOK_MAX_RETRIES=3
REMOTEOK_RETRY_SLEEP_SECONDS=3
REMOTEOK_REQUEST_TIMEOUT_SECONDS=30
REMOTEOK_FALLBACK_TO_EXISTING_RAW=true
REMOTEOK_MIN_FETCHED_JOBS=1


# ============================================================
# Training split / rare class handling
# ============================================================
MIN_SAMPLES_PER_CLASS=2
TEST_SIZE=0.3


# ============================================================
# Prediction quality gate
# ============================================================
MIN_AVG_PREDICTION_CONFIDENCE=0.6
MAX_LOW_CONFIDENCE_RATIO=0.4
MIN_PREDICTION_ROWS=1


# ============================================================
# Prediction drift check
# 0.1 이하  : 거의 안정적
# 0.1~0.25 : 약간의 분포 변화
# 0.25 이상: 의미 있는 분포 변화로 간주
# ============================================================
MAX_PREDICTION_DISTRIBUTION_PSI=0.25
MIN_DRIFT_CHECK_ROWS=1


# ============================================================
# Notification / alerting
# ============================================================
ALERT_ENABLED=true
ALERT_ONLY_ON_FAILURE=false
SLACK_WEBHOOK_URL=
ALERT_MAINTENANCE_MODE=false

ALERTMANAGER_URL=http://alertmanager:9093
ALERT_SILENCE_DEFAULT_MINUTES=30


# ============================================================
# Maintenance
# ============================================================
CLEANUP_DRY_RUN=true
API_LOG_RETENTION_DAYS=30
API_PREDICTION_RETENTION_DAYS=30
PIPELINE_CHECK_RETENTION_DAYS=90


# ============================================================
# Grafana
# ============================================================
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Production feedback evaluation
MIN_PRODUCTION_FEEDBACK_ROWS=10
MIN_PRODUCTION_ACCURACY=0.70
MIN_PRODUCTION_F1_WEIGHTED=0.70
PRODUCTION_FEEDBACK_WINDOW_DAYS=30
PRODUCTION_FEEDBACK_STRICT=false

# Feedback Ops DAG
# Cron expression for jobskill_feedback_ops.
# Use "manual", "none", or "off" to disable scheduled runs and keep manual trigger only.
FEEDBACK_OPS_DAG_SCHEDULE=0 9 * * *

# Production feedback evaluation thresholds
PRODUCTION_FEEDBACK_STRICT=false
MIN_PRODUCTION_FEEDBACK_ROWS=10
MIN_PRODUCTION_ACCURACY=0.70
MIN_PRODUCTION_F1_WEIGHTED=0.70
PRODUCTION_FEEDBACK_WINDOW_DAYS=30

# Retraining candidate decision thresholds
RETRAINING_CANDIDATE_STRICT=false
PRODUCTION_FEEDBACK_TREND_DROP_THRESHOLD=0.05
PRODUCTION_FEEDBACK_MIN_HISTORY_POINTS=3

# -----------------------------------------------------------------------------
# Retraining strategy / cost benchmark
# -----------------------------------------------------------------------------
# 재학습 후보 감지 이후 어떤 데이터 범위와 전략으로 재학습할지 판단하기 위한 기준입니다.
# 현재 운영 모델은 full retrain을 유지하고, 데이터 증가에 따라 window/sampling/incremental shadow 여부를 판단합니다.

RETRAINING_LOOKBACK_DAYS=180
RETRAINING_RECENT_DAYS=90

# full retrain을 row 수 기준으로 계속 허용할지 판단하는 기준입니다.
RETRAINING_MAX_FULL_RETRAIN_ROWS=100000

# 최근 window만으로 재학습 가능하다고 판단하기 위한 최소 row 수입니다.
RETRAINING_MIN_WINDOW_ROWS=1000

# 각 class별 최소 row 수입니다.
RETRAINING_MIN_ROWS_PER_CLASS=100

# production feedback이 없으면 WARN으로 볼지 여부입니다.
RETRAINING_FEEDBACK_REQUIRED=false
RETRAINING_FEEDBACK_LOOKBACK_DAYS=90

# 이 row 수 이상이면 incremental retraining shadow experiment를 검토합니다.
RETRAINING_INCREMENTAL_EXPERIMENT_ROW_THRESHOLD=500000

# full retrain이 너무 오래 걸리는지 판단하는 기준입니다.
RETRAINING_MAX_FULL_RETRAIN_SECONDS=1800

# 이 시간 이상 걸리면 incremental retraining shadow experiment를 검토합니다.
RETRAINING_INCREMENTAL_EXPERIMENT_SECONDS_THRESHOLD=3600

# -----------------------------------------------------------------------------
# Training data selection policy
# -----------------------------------------------------------------------------
# full:
#   cleaned_job_posts 전체를 학습 데이터로 사용합니다.
#
# lookback:
#   TRAINING_LOOKBACK_DAYS 기준 최근 데이터만 사용합니다.
#
# recent:
#   TRAINING_RECENT_DAYS 기준 최근 데이터만 사용합니다.
#
# recent_plus_history_sample:
#   최근 데이터 전체 + 과거 데이터 class별 sample을 함께 사용합니다.
#
TRAINING_DATA_MODE=full
TRAINING_DATE_COLUMN=training_event_at
TRAINING_LOOKBACK_DAYS=180
TRAINING_RECENT_DAYS=90
TRAINING_HISTORY_SAMPLE_ROWS_PER_CLASS=100
TRAINING_RANDOM_STATE=42
TRAINING_MIN_ROWS_AFTER_SELECTION=5

# -----------------------------------------------------------------------------
# Training data selection experiment
# -----------------------------------------------------------------------------
# 여러 training data mode를 순차 실행해 성능과 학습 비용을 비교합니다.
# 이 실험은 promoted model을 자동 변경하지 않습니다.
TRAINING_DATA_EXPERIMENT_MODES=full,recent,recent_plus_history_sample
TRAINING_DATA_SELECTION_EXPERIMENT_REPORT_PATH=reports/latest_training_data_selection_experiment_report.md

# -----------------------------------------------------------------------------
# Training event time resolution
# -----------------------------------------------------------------------------
# training data selection uses training_event_at as a normalized timestamp.
# The selector searches cleaned_job_posts first, then raw_job_posts.
TRAINING_CLEANED_TIME_COLUMNS=training_event_at,posted_at,published_at,created_at,updated_at,ingested_at,loaded_at,processed_at
TRAINING_RAW_TIME_COLUMNS=posted_at,published_at,collected_at,crawled_at,scraped_at,created_at,updated_at,ingested_at,loaded_at
TRAINING_EVENT_TIME_STRICT=false
TRAINING_EVENT_TIME_REPORT_PATH=reports/latest_training_event_time_report.md

# -----------------------------------------------------------------------------
# Training data selection policy recommendation
# -----------------------------------------------------------------------------
# Compare full retrain with recent/recent_plus_history_sample experiment results.
# This check recommends whether a non-full mode is worth repeated shadow validation.
# It does not promote or replace any model artifact.
TRAINING_SELECTION_MAX_ACCURACY_DROP=0.02
TRAINING_SELECTION_MAX_F1_DROP=0.02
TRAINING_SELECTION_MAX_DURATION_RATIO=0.90
TRAINING_SELECTION_MAX_ROW_RATIO=0.90
TRAINING_DATA_SELECTION_POLICY_WRITE_DB=true
TRAINING_DATA_SELECTION_POLICY_STRICT=false
TRAINING_DATA_SELECTION_POLICY_REPORT_PATH=reports/latest_training_data_selection_policy_report.md

# -----------------------------------------------------------------------------
# Historical seed data for local training selection validation
# -----------------------------------------------------------------------------
# This is not the production ingestion path.
# Remote OK crawler remains the real ingestion flow.
# Historical seed rows are used only to validate retraining selection policy
# with enough event-time distribution in a local environment.
HISTORICAL_SEED_SOURCE=remoteok_seed
HISTORICAL_SEED_ROWS=5000
HISTORICAL_SEED_HISTORY_DAYS=240
HISTORICAL_SEED_RANDOM_SEED=42
HISTORICAL_SEED_END_DATE=2026-08-07

# Evidence gate for training data selection policy.
# Non-full modes are not recommended when the experiment does not have enough
# data, class coverage, or actual row reduction.
TRAINING_SELECTION_MIN_BASELINE_ROWS=3000
TRAINING_SELECTION_MIN_ROWS_PER_CLASS=300
TRAINING_SELECTION_REQUIRE_ROW_REDUCTION=true
TRAINING_SELECTION_MIN_REPEATED_RUNS=1